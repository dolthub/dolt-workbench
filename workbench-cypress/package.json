{
  "name": "workbench-cypress",
  "version": "0.1.0",
  "description": "",
  "author": "DoltHub",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "cy-chrome": "cypress run --browser chrome",
    "cy-open-local": "CYPRESS_LOCAL=true cypress open --config baseUrl=http://localhost:3002,numTestsKeptInMemory=0",
    "cy-run-local": "CYPRESS_LOCAL=true cypress run --config baseUrl=http://localhost:3002",
    "ci": "npm-run-all prettier compile lint",
    "compile": "tsc -b",
    "lint": "eslint --cache --ext .ts,.js .",
    "prettier": "prettier --check 'cypress/**/*.{ts,js}'",
    "prettier:fix": "prettier --write 'cypress/**/*.{ts,js}'"
  },
  "dependencies": {
    "cypress": "^15.21.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@cypress/github-action": "^7.4.1",
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-import": "^2.32.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1"
  },
  "resolutions": {
    "form-data": "4.0.6",
    "tmp": "0.2.7",
    "glob": "10.5.0",
    "minimatch@npm:^9.0.4": "9.0.9",
    "picomatch@npm:^4.0.2": "4.0.4",
    "picomatch@npm:^4.0.3": "4.0.4",
    "lodash": "4.18.0",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
