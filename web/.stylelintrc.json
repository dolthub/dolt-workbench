{
  "extends": "stylelint-config-recommended",
  "rules": {
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["tailwind", "screen"] }],
    "declaration-property-value-no-unknown": null,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ]
  }
}
